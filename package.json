{
  "name": "narrative-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "story:build": "node scripts/compile-story.mjs",
    "story:check": "node scripts/compile-story.mjs --check",
    "dev": "bun run story:build && vite",
    "build": "bun run story:build && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome check src/",
    "format": "biome check --write src/"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "elkjs": "^0.12.0",
    "inkjs": "^2.2.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "~5.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "vitest": "^4.0.0",
    "@biomejs/biome": "^1.9.0"
  }
}
